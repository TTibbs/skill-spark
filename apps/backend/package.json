{
  "name": "@skill-spark/backend",
  "author": "tibbs",
  "version": "1.0.0",
  "description": "Express app",
  "main": "listener.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/your-repo-name.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/your-repo-name/issues"
  },
  "homepage": "https://github.com/yourusername/your-repo-name#readme",
  "keywords": [],
  "license": "MIT",
  "scripts": {
    "dev": "nodemon listener.ts",
    "start": "nodemon listener.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "setup-dbs": "psql -f ./db/setup.sql",
    "seed": "ts-node db/seeds/run-seed.ts",
    "seed-dev": "NODE_ENV=development npm run seed",
    "seed-prod": "NODE_ENV=production npm run seed",
    "test": "jest",
    "ft": "jest --runInBand",
    "ct": "jest --runInBand --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.1.0",
    "nodemon": "^3.1.9",
    "pg": "^8.14.1",
    "pg-format": "^1.0.4",
    "resend": "^6.1.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "@types/pg-format": "^1.0.5",
    "@types/supertest": "^6.0.3",
    "husky": "^9.1.7",
    "jest-extended": "^4.0.2",
    "jest-sorted": "^1.0.15",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "maxWorkers": 1,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "setupFilesAfterEnv": [
      "jest-extended/all",
      "jest-sorted"
    ]
  }
}
